# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/taskflowdb?retryWrites=true&w=majority

# Server Port
PORT=5000

# Node Environment
NODE_ENV=production

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend-url.vercel.app
