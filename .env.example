# ─── TaskFlow Docker Environment Variables Template ───────────────────────────
# Copy this file to .env and fill in your actual credentials.
# NOTE: .env is ignored by Git to protect secrets and connection strings.

# MongoDB Atlas URI (AWS ap-south-1 Mumbai)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.cugknam.mongodb.net/taskflowdb?retryWrites=true&w=majority&appName=Cluster0

# JWT Authentication Secret
JWT_SECRET=taskflow_super_secret_jwt_key_2026

# Internal Node Environment & Port
NODE_ENV=production
PORT=5000
FRONTEND_URL=http://localhost:3000
